#!/usr/bin/env bash
# preen-release-gate — the mechanical half of cutting a release, in a script
# rather than inline in a workflow, so tests/test-release-gate.sh can exercise
# it. A workflow step is not testable; this is.
#
#   preen-release-gate version [DIR]   print VERSION, trailing newline stripped
#   preen-release-gate check [DIR]     VERSION must be N.N.N and CHANGELOG.md
#                                      must have a `## [N.N.N]` section for it.
#                                      Exit 1, with the reason, if not.
#   preen-release-gate notes [DIR]     print that section, heading dropped, for
#                                      use as a release body
#
# DIR defaults to the current directory. Every refusal is exit 1 with the reason
# on stderr; a usage error is exit 2.
#
# VERSION is the single source of truth for the release number, so a bump to it
# is what declares a release, and this is what stops that bump shipping without
# the changelog entry that says what it holds.
#
# Deliberately NOT release-please or semantic-release. Both derive the changelog
# from commit subjects, and this project writes prose subjects, not Conventional
# Commits. Adopting either would mean rewording every commit AND replacing a
# hand-written changelog with a worse generated one. The prose stays human; only
# the bookkeeping is automated.
set -euo pipefail

# [0-9] means ASCII digits only in the C locale.
export LC_ALL=C

me=preen-release-gate

usage() { echo "usage: $me version|check|notes [DIR]" >&2; exit 2; }

die() {
  # die <reason> [detail...] -> the reason on stderr, details indented under it
  printf '%s: %s\n' "$me" "$1" >&2
  shift
  for line in "$@"; do printf '  %s\n' "$line" >&2; done
  exit 1
}

[ $# -ge 1 ] && [ $# -le 2 ] || usage
cmd="$1"; dir="${2:-.}"
case "$cmd" in version|check|notes) ;; *) usage ;; esac

ver_file="$dir/VERSION"
log_file="$dir/CHANGELOG.md"

[ -f "$ver_file" ] || die "no VERSION file at $ver_file"

# $(cat) drops the trailing newline and nothing else. Stripping all whitespace
# would turn "1.2 .3" into a valid 1.2.3; a stray space or CR is refused below
# instead, so the file on disk is exactly what gets tagged.
v="$(cat "$ver_file")"

# Anchored against the whole string, so "1.2.3.4", "v1.2.3" and an empty file
# all fail, and so does a second line after a good first one. The pattern lives
# in a variable because a quoted pattern is matched literally, not as a regex.
exact='^[0-9]+\.[0-9]+\.[0-9]+$'
[[ $v =~ $exact ]] || die "VERSION is '$v', which is not N.N.N"

if [ "$cmd" = version ]; then
  printf '%s\n' "$v"
  exit 0
fi

[ -f "$log_file" ] || die "no CHANGELOG.md at $log_file"

heading="## [$v]"

# The whole line, not a substring: "## [0.1.0" is found inside
# "## [0.1.0-rc1]", and a release candidate's section is not the release's.
# The version is only digits and dots by now, so awk -v has nothing to unescape.
awk -v h="$heading" '$0 == h { found = 1; exit } END { exit !found }' "$log_file" \
  || die "VERSION is $v but CHANGELOG.md has no '$heading' section." \
         "The tag job publishes that section as the release body, so an" \
         "unwritten section would ship an empty release."

case "$cmd" in
  check)
    printf 'VERSION %s has a CHANGELOG.md section.\n' "$v"
    ;;
  notes)
    # From the heading to the next `## [`, heading dropped. The stop is `## [`
    # and not `##`, because a `### Added` inside the section starts with `##`
    # too. Blank lines before the body are dropped; the capture drops the ones
    # after it.
    out="$(awk -v h="$heading" '
      $0 == h { inside = 1; next }
      !inside { next }
      index($0, "## [") == 1 { exit }
      !started && /^[[:space:]]*$/ { next }
      { started = 1; print }
    ' "$log_file")"
    [ -n "$out" ] || die "the '$heading' section is empty — refusing to publish" \
                         "a release with no body."
    printf '%s\n' "$out"
    ;;
esac
