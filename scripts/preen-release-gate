#!/usr/bin/env bash
# preen-release-gate — the mechanical half of cutting a release, in a script
# rather than inline in a workflow, so tests/test-release-gate.sh can exercise
# it. A workflow step is not testable; this is.
#
#   preen-release-gate version [DIR]   print VERSION, trailing newlines
#                                      stripped. Exit 1 if it is not N.N.N.
#   preen-release-gate check [DIR]     VERSION must be N.N.N and CHANGELOG.md
#                                      must have a `## [N.N.N]` section for it.
#                                      Exit 1, with the reason, if not.
#   preen-release-gate notes [DIR]     print that section, heading dropped, for
#                                      use as a release body
#
# DIR defaults to the current directory. Every refusal is exit 1 with the reason
# on stderr; a usage error is exit 2.
#
# VERSION is the single source of truth for the release number, so a bump to it
# is what declares a release, and this is what stops that bump shipping without
# the changelog entry that says what it holds.
#
# Deliberately NOT release-please or semantic-release. Both derive the changelog
# from commit subjects, and this project writes prose subjects, not Conventional
# Commits. Adopting either would mean rewording every commit AND replacing a
# hand-written changelog with a worse generated one. The prose stays human; only
# the bookkeeping is automated.
set -euo pipefail

# [0-9] means ASCII digits only in the C locale.
export LC_ALL=C

me=preen-release-gate

usage() { echo "usage: $me version|check|notes [DIR]" >&2; exit 2; }

die() {
  # die <reason> [detail...] -> the reason on stderr, details indented under it
  printf '%s: %s\n' "$me" "$1" >&2
  shift
  for line in "$@"; do printf '  %s\n' "$line" >&2; done
  exit 1
}

[ $# -ge 1 ] && [ $# -le 2 ] || usage
cmd="$1"; dir="${2:-.}"
case "$cmd" in version|check|notes) ;; *) usage ;; esac

ver_file="$dir/VERSION"
log_file="$dir/CHANGELOG.md"

[ -f "$ver_file" ] || die "no VERSION file at $ver_file"

# $(cat) drops trailing newlines and nothing else. Stripping all whitespace, as
# roost's copy does, would turn "1.2 .3" into a valid 1.2.3; a stray space, CR
# or second line is refused below instead, so what gets tagged is exactly what
# the file says. tests/test-release-gate.sh holds all three.
v="$(cat "$ver_file")"

# Anchored against the whole string, so "1.2.3.4", "v1.2.3" and an empty file
# all fail, and so does a second line after a good first one. The pattern lives
# in a variable because a quoted pattern is matched literally, not as a regex.
exact='^[0-9]+\.[0-9]+\.[0-9]+$'
if ! [[ $v =~ $exact ]]; then
  # %q, not raw: a CR prints as nothing at all, so a CI log would read
  # `VERSION is '1.2.3', which is not N.N.N` and look like a lie. %q shows it
  # as $'1.2.3\r'. bash 3.2 has both %q and printf -v.
  printf -v shown '%q' "$v"
  die "VERSION is $shown, which is not N.N.N" \
      "N.N.N is three numbers and two dots, alone in the file: 1.2.3." \
      "A space, a carriage return or a second line is refused, so what is" \
      "tagged is exactly what the file says."
fi

if [ "$cmd" = version ]; then
  printf '%s\n' "$v"
  exit 0
fi

[ -f "$log_file" ] || die "no CHANGELOG.md at $log_file"

heading="## [$v]"

# One rule for what counts as this version's heading, shared by check and notes.
# They have to agree: a check that passes where notes then finds nothing would
# fail at tag time, having said the release was ready.
#
# The line, not a substring: "## [0.1.0" is found inside "## [0.1.0-rc1]", and a
# release candidate's section is not the release's. Two things are forgiven: a
# trailing CR, so a changelog written on Windows still matches, and anything at
# all after a space or a tab, which is where Keep a Changelog puts the date:
#
#     ## [1.2.3] - 2026-09-17
#     ## [1.2.3] - 2026-09-17 [YANKED]
#
# Whatever follows that space is not read. A date is what belongs there, but this
# is not the place to have an opinion about how it is written. Trailing spaces
# need no rule of their own: they are already "a space, then nothing".
#
# The version is only digits and dots by now, so awk -v has nothing to unescape.
is_heading='
  function is_heading(line,   after) {
    sub(/\r$/, "", line)
    if (line == h) return 1
    if (index(line, h) != 1) return 0
    after = substr(line, length(h) + 1, 1)
    return after == " " || after == "\t"
  }
'

awk -v h="$heading" "$is_heading"'
  is_heading($0) { found = 1; exit }
  END { exit !found }
' "$log_file" \
  || die "VERSION is $v but CHANGELOG.md has no '$heading' section." \
         "That heading must be a line of its own: '$heading', or that" \
         "followed by a space and a date, as in '$heading - 2026-09-17'." \
         "The tag job publishes that section as the release body, so an" \
         "unwritten section would ship an empty release."

case "$cmd" in
  check)
    printf 'VERSION %s has a CHANGELOG.md section.\n' "$v"
    ;;
  notes)
    # From the heading to the next `## [`, heading dropped. The stop is `## [`
    # and not `##`, because a `### Added` inside the section starts with `##`
    # too. Blank lines before the body are dropped; the capture drops the ones
    # after it.
    out="$(awk -v h="$heading" "$is_heading"'
      !inside && is_heading($0) { inside = 1; next }
      !inside { next }
      index($0, "## [") == 1 { exit }
      !started && /^[[:space:]]*$/ { next }
      { started = 1; sub(/\r$/, ""); print }
    ' "$log_file")"
    [ -n "$out" ] || die "the '$heading' section is empty — refusing to publish" \
                         "a release with no body."
    printf '%s\n' "$out"
    ;;
esac
