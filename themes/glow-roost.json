{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#c8c3e0",
    "margin": 2
  },
  "block_quote": {
    "color": "#8a84b0",
    "italic": true,
    "indent": 1,
    "indent_token": "│ "
  },
  "paragraph": {},
  "list": {
    "color": "#c8c3e0",
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#bd93f9",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#12101f",
    "background_color": "#7c6ff0",
    "bold": true
  },
  "h2": { "prefix": "┃ ", "color": "#bd93f9" },
  "h3": { "prefix": "┃ ", "color": "#9d8df5" },
  "h4": { "prefix": "┃ ", "color": "#8a84b0" },
  "h5": { "prefix": "┃ ", "color": "#8a84b0" },
  "h6": { "prefix": "┃ ", "color": "#8a84b0", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true, "color": "#8a84b0" },
  "emph": { "italic": true },
  "strong": { "bold": true, "color": "#e0dcf5" },
  "hr": { "color": "#7c6ff0", "format": "\n────────────────────────────────────────\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#8be9fd", "underline": true },
  "link_text": { "color": "#bd93f9", "bold": true },
  "image": { "color": "#8be9fd", "underline": true },
  "image_text": { "color": "#8a84b0", "format": "image: {{.text}} →" },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#ff79c6",
    "background_color": "#2a2640"
  },
  "code_block": {
    "color": "#c8c3e0",
    "margin": 2,
    "chroma": {
      "text": { "color": "#c8c3e0" },
      "error": { "color": "#ff5555" },
      "comment": { "color": "#6272a4", "italic": true },
      "comment_preproc": { "color": "#ff79c6" },
      "keyword": { "color": "#ff79c6" },
      "keyword_reserved": { "color": "#ff79c6" },
      "keyword_namespace": { "color": "#ff79c6" },
      "keyword_type": { "color": "#8be9fd" },
      "operator": { "color": "#ff79c6" },
      "punctuation": { "color": "#c8c3e0" },
      "name": { "color": "#c8c3e0" },
      "name_builtin": { "color": "#8be9fd", "italic": true },
      "name_tag": { "color": "#ff79c6" },
      "name_attribute": { "color": "#50fa7b" },
      "name_class": { "color": "#50fa7b", "underline": true },
      "name_constant": { "color": "#bd93f9" },
      "name_decorator": { "color": "#50fa7b" },
      "name_exception": { "color": "#ff5555" },
      "name_function": { "color": "#50fa7b" },
      "name_other": { "color": "#c8c3e0" },
      "literal": { "color": "#bd93f9" },
      "literal_number": { "color": "#bd93f9" },
      "literal_date": { "color": "#f1fa8c" },
      "literal_string": { "color": "#f1fa8c" },
      "literal_string_escape": { "color": "#ff79c6" },
      "generic_deleted": { "color": "#ff5555" },
      "generic_emph": { "italic": true },
      "generic_inserted": { "color": "#50fa7b" },
      "generic_strong": { "bold": true },
      "generic_subheading": { "color": "#bd93f9" },
      "background": { "background_color": "#211e38" }
    }
  },
  "table": {
    "center_separator": "┼",
    "column_separator": "│",
    "row_separator": "─"
  },
  "definition_list": {},
  "definition_term": {},
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
