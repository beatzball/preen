#!/usr/bin/env bash
# preen — browse markdown and diffs in the terminal.
#   glow renders the markdown, delta renders the diffs, fzf does the file nav.
set -uo pipefail

GLOW_STYLE="${PREEN_GLOW_STYLE:-$HOME/.config/glow/roost.json}"
[ -f "$GLOW_STYLE" ] || GLOW_STYLE="dark"
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

die() { printf 'preen: %s\n' "$*" >&2; exit 1; }
glow_major() { glow --version 2>/dev/null | sed -n 's/.*version \([0-9][0-9]*\).*/\1/p'; }

# ---- render one file, no fzf -------------------------------------------------
# glow 3 keeps its colors when stdout is a pipe, which is what fzf hands a
# preview. glow 2 silently drops them, so install.sh requires 3.0.0 or newer.
# stdin must be /dev/null: glow reads the file by name, but still blocks on an
# open stdin, which leaves a preview hanging on "Loading ...".
render_md() {
  glow -s "$GLOW_STYLE" -w "${1:-$(tput cols 2>/dev/null || echo 80)}" "$2" </dev/null
}

# git, optionally inside another worktree. An empty dir means "right here", so
# every caller can pass one argument and stop thinking about it.
#
# core.quotePath=false lives here rather than at the call sites. git escapes a
# non-ASCII path by default, so "café.txt" comes back as "caf\303\251.txt" --
# a name that gets counted and listed but cannot then be opened, giving a
# blank preview. It has to be off for EVERY command that prints or accepts a
# path, and setting it once here is the only way that stays true as call sites
# are added.
#
# It does not cover everything: git always escapes a double quote, a backslash
# and control characters whatever this is set to, so a filename containing one
# is still broken. That needs -z and `read -d ""` at every path-output site.
gitw() {
  local d="$1"; shift
  if [ -n "$d" ]; then
    git -C "$d" -c core.quotePath=false "$@"
  else
    git -c core.quotePath=false "$@"
  fi
}

render_diff() {
  local width="$1" file="$2" mode="$3" rev="$4" dir="${5:-}"
  {
    if ! gitw "$dir" ls-files --error-unmatch -- "$file" >/dev/null 2>&1; then
      # untracked: show the whole file as an addition
      gitw "$dir" diff --no-index --color=always -- /dev/null "$file" 2>/dev/null
    elif [ -n "$rev" ]; then
      gitw "$dir" diff --color=always "$rev" -- "$file"
    elif gitw "$dir" rev-parse --verify -q HEAD >/dev/null 2>&1; then
      gitw "$dir" diff --color=always HEAD -- "$file"   # staged and unstaged together
    else
      gitw "$dir" diff --color=always --cached -- "$file"   # repo with no commit yet
    fi
  } | delta_pipe "$mode" "$width"
}

# the one delta invocation, shared by render_diff and the stdin path
delta_pipe() { delta --features "$1" --paging=never --width "$2"; }

# ---- worktrees ---------------------------------------------------------------
# Agents work in git worktrees. This mode answers "what did each of them
# change?" without touching any of them: every git call below only reads.

# origin/HEAD names the default branch. Without it, fall back to main, then
# master, local branch first and remote-tracking second.
default_branch() {
  local d="$1" ref c
  ref="$(gitw "$d" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null)"
  [ -n "$ref" ] && { printf '%s\n' "$ref"; return 0; }
  for c in main master; do
    gitw "$d" rev-parse --verify -q "refs/heads/$c" >/dev/null 2>&1 \
      && { printf '%s\n' "$c"; return 0; }
    gitw "$d" rev-parse --verify -q "refs/remotes/origin/$c" >/dev/null 2>&1 \
      && { printf '%s\n' "origin/$c"; return 0; }
  done
  return 1
}

# where the worktree left the default branch. Diffing against that, and not
# against the tip, keeps later commits on the default branch out of the picture.
wt_base() {
  local d="$1" def
  def="$(default_branch "$d")" || return 1
  gitw "$d" merge-base "$def" HEAD 2>/dev/null
}

wt_branch() {
  gitw "$1" symbolic-ref -q --short HEAD 2>/dev/null || printf 'detached\n'
}

# every path the worktree touches: committed since the base, still uncommitted,
# or never added at all
wt_files() {
  local d="$1" base="$2"
  {
    if [ -n "$base" ]; then
      gitw "$d" diff --name-only "$base"
    else
      gitw "$d" diff --name-only HEAD
    fi
    gitw "$d" ls-files --others --exclude-standard
  } 2>/dev/null | grep -v '^$' | sort -u
}

# one line per worktree: a padded label for the eye, then a tab and the absolute
# path for the callbacks. git always prints the main checkout first, and that is
# not what this mode is about, so the first record becomes the root and is
# dropped from the list. The count leads because the list pane is narrow and a
# long path is the one column that can afford to run off the end.
wt_list() {
  git worktree list --porcelain 2>/dev/null \
    | awk '/^worktree /{print substr($0, 10)}' \
    | {
        root=""
        while IFS= read -r path; do
          [ -n "$root" ] || { root="$path"; continue; }
          base="$(wt_base "$path" 2>/dev/null)"
          n="$(wt_files "$path" "$base" | wc -l | tr -d ' ')"
          [ "$n" = 1 ] && word=file || word=files
          printf '%4s %-5s  %-24s  %s\t%s\n' \
            "$n" "$word" "$(wt_branch "$path")" "${path#"$root"/}" "$path"
        done
      }
}

# the level-one preview: what this worktree is, what it committed, what it changed
render_wt() {
  local w="$1" dir="$2" mode="$3" base def
  def="$(default_branch "$dir" 2>/dev/null)" || def="?"
  base="$(wt_base "$dir" 2>/dev/null)"
  printf 'worktree  %s\n' "$dir"
  printf 'branch    %s\n' "$(wt_branch "$dir")"
  printf 'base      %s  (merge-base with %s)\n\n' "$(printf '%s' "${base:-none}" | cut -c1-12)" "$def"
  {
    if [ -n "$base" ]; then
      gitw "$dir" log --color=always --oneline --no-decorate "$base..HEAD" 2>/dev/null
      printf '\n'
      gitw "$dir" diff --color=always "$base" 2>/dev/null
    else
      gitw "$dir" diff --color=always HEAD 2>/dev/null
    fi
    # git diff never reports a file it has not been told about, but wt_files
    # counts untracked ones -- so without this a worktree could say "2 files"
    # and preview one. Each is shown whole, as an addition, exactly as the
    # per-file view does it.
    gitw "$dir" ls-files --others --exclude-standard 2>/dev/null |
      while IFS= read -r u; do
        [ -n "$u" ] || continue
        gitw "$dir" diff --no-index --color=always -- /dev/null "$u" 2>/dev/null
      done
  } | delta_pipe "$mode" "$w"
}

# ---- pull requests -----------------------------------------------------------
# Starting a review costs four gh calls whatever the size of the PR: auth
# status, pr view, and pr diff twice (the diff itself, then --name-only for the
# file list). The diff is cached in the state dir and each preview slices its
# own file out of it, so nothing goes to the network per file.
# The header line is "diff --git a/PATH b/PATH"; match on the " b/PATH" tail so
# a path that itself contains " b/" does not confuse the split.
pr_slice() {
  awk -v f="$1" '
    /^diff --git / {
      tail = " b/" f
      inblk = (substr($0, length($0) - length(tail) + 1) == tail)
    }
    inblk { print }
  ' "$2"
}

# "gh pr view" with no number resolves the PR of the current branch. Bash 3.2
# trips on "$@" with no positional args under set -u, hence the two calls.
pr_meta() {
  if [ -n "$1" ]; then
    gh pr view "$1" --json number,title -q '"\(.number)\t\(.title)"'
  else
    gh pr view --json number,title -q '"\(.number)\t\(.title)"'
  fi
}

render_pr() {
  local width="$1" file="$2" mode="$3" cache="$4"
  pr_slice "$file" "$cache" | delta_pipe "$mode" "$width"
}

# ---- read from a pipe --------------------------------------------------------
# "preen" with stdin on a pipe, or an explicit "preen -", renders whatever is
# piped in and quits. A diff goes to delta, anything else to glow. Both keep
# their colors when stdout is a pipe, so "| less -R" and "| head" still work.
need_glow() {
  command -v glow >/dev/null || die "glow is not installed"
  [ "$(glow_major)" -ge 3 ] 2>/dev/null \
    || die "glow 3 or newer is needed for colored output (found: $(glow --version 2>/dev/null)); run install.sh"
}

layout_mode() {
  case "${PREEN_LAYOUT:-sbs}" in inline) echo inline ;; *) echo sbs ;; esac
}

# git diff --color=always paints the headers, so strip CSI escapes before the
# sniff or "^--- " never matches. BSD sed has no \x1b, hence the printf.
strip_ansi() { sed "s/$(printf '\033')\[[0-9;]*[a-zA-Z]//g"; }

# unified diff headers. "--- " alone is not enough: markdown uses it too, so
# that pair only counts when "+++ " is there as well.
looks_like_diff() {
  local top; top="$(head -n 200 "$1" | strip_ansi)"
  printf '%s\n' "$top" | grep -q '^diff --git ' && return 0
  printf '%s\n' "$top" | grep -q '^@@ .* @@' && return 0
  printf '%s\n' "$top" | grep -q '^--- ' \
    && printf '%s\n' "$top" | grep -q '^+++ ' && return 0
  return 1
}

# a terminal gets a pager, a pipe gets the bytes
pager() { if [ -t 1 ]; then less -R; else cat; fi; }

# PREEN_BUF and PREEN_BUFDIR are global on purpose: the EXIT trap runs after the
# function has returned, so a "local" would already be out of scope and set -u
# would trip.
render_stdin() {
  local width
  # the buffer has to end in .md: glow 3 renders a file with any other
  # extension as plain text, so stdin markdown came out unstyled
  PREEN_BUFDIR="$(mktemp -d "${TMPDIR:-/tmp}/preen-stdin.XXXXXX")"
  PREEN_BUF="$PREEN_BUFDIR/input.md"
  trap 'rm -rf "$PREEN_BUFDIR"' EXIT
  cat > "$PREEN_BUF"
  [ -s "$PREEN_BUF" ] || die "nothing on stdin"
  width="$(tput cols 2>/dev/null || echo 80)"
  if looks_like_diff "$PREEN_BUF"; then
    command -v delta >/dev/null || die "delta is not installed"
    delta_pipe "$(layout_mode)" "$width" < "$PREEN_BUF" | pager
  else
    need_glow
    render_md "$width" "$PREEN_BUF" | pager
  fi
}

# ---- hooks fzf calls back into ----------------------------------------------
case "${1:-}" in
  --preview)
    f="$2"; w="${FZF_PREVIEW_COLUMNS:-80}"
    kind="$(cat "$PREEN_STATE/kind" 2>/dev/null || echo diff)"
    if [ "$kind" = md ]; then
      render_md "$w" "$f"
    elif [ "$kind" = wt ]; then
      render_wt "$w" "$f" "$(cat "$PREEN_STATE/mode" 2>/dev/null || echo sbs)"
    elif [ "$kind" = none ]; then
      printf '%s\n' "$f"
    elif [ "$kind" = pr ]; then
      render_pr "$w" "$f" \
        "$(cat "$PREEN_STATE/mode" 2>/dev/null || echo sbs)" "$PREEN_STATE/pr.diff"
    else
      render_diff "$w" "$f" \
        "$(cat "$PREEN_STATE/mode" 2>/dev/null || echo sbs)" \
        "$(cat "$PREEN_STATE/rev"  2>/dev/null || echo '')" \
        "$(cat "$PREEN_STATE/dir"  2>/dev/null || echo '')"
    fi
    exit 0 ;;
  --show)
    f="$2"; w="$(tput cols)"
    kind="$(cat "$PREEN_STATE/kind" 2>/dev/null || echo diff)"
    if [ "$kind" = md ]; then
      render_md "$w" "$f" | less -R
    elif [ "$kind" = wt ]; then
      render_wt "$w" "$f" "$(cat "$PREEN_STATE/mode" 2>/dev/null || echo sbs)" | less -R
    elif [ "$kind" = pr ]; then
      render_pr "$w" "$f" \
        "$(cat "$PREEN_STATE/mode" 2>/dev/null || echo sbs)" "$PREEN_STATE/pr.diff" | less -R
    else
      render_diff "$w" "$f" \
        "$(cat "$PREEN_STATE/mode" 2>/dev/null || echo sbs)" \
        "$(cat "$PREEN_STATE/rev"  2>/dev/null || echo '')" \
        "$(cat "$PREEN_STATE/dir"  2>/dev/null || echo '')" | less -R
    fi
    exit 0 ;;
  --toggle)
    m="$(cat "$PREEN_STATE/mode" 2>/dev/null || echo sbs)"
    [ "$m" = sbs ] && echo inline > "$PREEN_STATE/mode" || echo sbs > "$PREEN_STATE/mode"
    exit 0 ;;
esac

# ---- pick a mode -------------------------------------------------------------
KIND=""; REV=""; PR=""
case "${1:-}" in
  md)   KIND=md;   shift; TARGET="${1:-.}" ;;
  diff) KIND=diff; shift; REV="${1:-}" ;;
  pr)   KIND=pr;   shift; PR="${1:-}" ;;
  worktrees|wt) KIND=wt; shift ;;
  -h|--help)
    cat <<'H'
preen — markdown and diffs in the terminal

  preen                 auto: diffs in a git repo, else markdown
  preen md [DIR]        browse markdown files under DIR (default .)
  preen diff [REV]      browse files changed vs REV (default: working tree)
  preen pr [NUMBER]     browse the files in a GitHub PR (default: this branch)
  preen worktrees       pick a git worktree, then browse what it changed
  preen wt              short for the same
  preen FILE.md         render one file and quit
  ... | preen           render piped input and quit
  preen - < FILE        the same, said out loud

pr mode needs the gh CLI. It reads the PR diff over the network and shows it,
with no checkout, no fetch and no stash. The one key that reaches your
checkout is ctrl-e, which opens your own copy of the file's path in $EDITOR.

worktrees mode lists every worktree except the main checkout, with its branch
and how many files it changed against the merge-base with the default branch
(read from origin/HEAD, else main, else master). Uncommitted and untracked
files are counted too. Pick one and the normal file picker opens on it; esc
goes back to the worktree list, ctrl-c quits. It is read-only as well: no
checkout, no fetch, no stash, nothing is written to any worktree.

piped input picks its own renderer: a unified diff goes to delta, anything
else goes to glow. On a terminal the result is paged through less -R; into a
pipe it is written plain, with the color kept. PREEN_LAYOUT=inline applies.

keys inside the picker
  ctrl-d / ctrl-u            scroll the preview 8 lines
  pgdn / pgup                scroll the preview half a page
  shift-down / shift-up      scroll the preview one line
  home / end                 jump the preview to top or bottom
  ctrl-s   toggle side-by-side <-> inline (diff, pr and worktrees modes)
           start in inline with PREEN_LAYOUT=inline
  enter    open the full render in a pager
  ctrl-e   open in $EDITOR
  ctrl-/   hide or show the preview
  esc      quit, or in worktrees mode go back one level
  ctrl-c   quit
H
    exit 0 ;;
  -) render_stdin; exit 0 ;;
  "") [ -t 0 ] || { render_stdin; exit 0; } ;;
  *)
    [ -f "$1" ] || die "no such file: $1"
    render_md "$(tput cols)" "$1"; exit 0 ;;
esac

if [ -z "$KIND" ]; then
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 && KIND=diff || { KIND=md; TARGET=.; }
fi

command -v fzf >/dev/null || die "fzf is not installed"
need_glow

# ---- state shared with the fzf callbacks ------------------------------------
# built before the file list because pr mode caches its diff in here
PREEN_STATE="$(mktemp -d "${TMPDIR:-/tmp}/preen.XXXXXX")"
trap 'rm -rf "$PREEN_STATE"' EXIT
echo "$KIND" > "$PREEN_STATE/kind"
case "${PREEN_LAYOUT:-sbs}" in inline) echo inline ;; *) echo sbs ;; esac > "$PREEN_STATE/mode"
echo "$REV"  > "$PREEN_STATE/rev"
: > "$PREEN_STATE/dir"          # empty: git runs here, not in another worktree
export PREEN_STATE GLOW_STYLE

# ---- the picker --------------------------------------------------------------
# One fzf invocation for every mode and every level. The caller sets FILES,
# LABEL, HEADER, PROMPT, WITH_NTH (which fields are shown), PICK (which field
# the callbacks are handed), EDIT (what ctrl-e opens) and ENTER (what enter
# does), so a second level costs a few variables rather than a second block.
FILES=""; LABEL=""; HEADER=""; PROMPT='  file ❯ '
WITH_NTH='..'; PICK='{}'; EDIT='{}'; ENTER=""

run_picker() {
  printf '%s\n' "$FILES" | fzf \
    --ansi --no-multi --cycle \
    --layout=reverse \
    --border=rounded \
    --border-label="$LABEL" \
    --delimiter=$'\t' --with-nth="$WITH_NTH" \
    --preview "$SELF --preview $PICK" \
    --preview-window 'right,65%,border-left' \
    --header "$HEADER" \
    --prompt "$PROMPT" \
    --pointer '▎' --marker ' ' \
    --color 'fg:#c8c3e0,fg+:#e0dcf5,bg+:#2a2640,hl:#bd93f9,hl+:#bd93f9' \
    --color 'border:#7c6ff0,label:#bd93f9,prompt:#7c6ff0,pointer:#bd93f9' \
    --color 'header:#8a84b0,info:#8a84b0,spinner:#7c6ff0,marker:#3a3558' \
    --bind "ctrl-s:execute-silent($SELF --toggle)+refresh-preview" \
    --bind "enter:$ENTER" \
    --bind "ctrl-e:execute(\${EDITOR:-vi} $EDIT)" \
    --bind "ctrl-c:execute-silent(touch '$PREEN_STATE/quit')+abort" \
    --bind 'ctrl-/:toggle-preview' \
    --bind 'ctrl-d:preview-down+preview-down+preview-down+preview-down+preview-down+preview-down+preview-down+preview-down' \
    --bind 'ctrl-u:preview-up+preview-up+preview-up+preview-up+preview-up+preview-up+preview-up+preview-up' \
    --bind 'pgdn:preview-half-page-down' \
    --bind 'pgup:preview-half-page-up' \
    --bind 'shift-down:preview-down' \
    --bind 'shift-up:preview-up' \
    --bind 'home:preview-top' \
    --bind 'end:preview-bottom'
}

# ---- worktrees: pick a worktree, then browse its diff -------------------------
# Level one accepts, so the picked line comes back on stdout; level two uses
# the same enter binding as diff mode. esc at level two falls out of the inner
# picker and the loop paints level one again.
wt_loop() {
  local sel dir base branch
  while :; do
    echo wt > "$PREEN_STATE/kind"
    : > "$PREEN_STATE/dir"; : > "$PREEN_STATE/rev"
    FILES="$WTS"; WITH_NTH=1; PICK='{2}'; EDIT='{2}'; ENTER='accept'
    LABEL=" preen · worktrees "
    PROMPT='  worktree ❯ '
    HEADER=$'ctrl-d / ctrl-u  scroll · pgdn / pgup  page\nctrl-s layout · enter open · esc quit'
    sel="$(run_picker)"
    [ -n "$sel" ] || return 0
    [ -f "$PREEN_STATE/quit" ] && return 0

    dir="${sel#*$'\t'}"
    base="$(wt_base "$dir" 2>/dev/null)"
    branch="$(wt_branch "$dir")"
    FILES="$(wt_files "$dir" "$base")"
    printf '%s' "$dir"  > "$PREEN_STATE/dir"
    printf '%s' "$base" > "$PREEN_STATE/rev"
    WITH_NTH='..'; PICK='{}'
    LABEL=" preen · wt · $branch "
    PROMPT='  file ❯ '
    if [ -n "$FILES" ]; then
      echo diff > "$PREEN_STATE/kind"
      EDIT="\"$dir\"/{}"
      ENTER="execute($SELF --show {})"
      HEADER=$'ctrl-d / ctrl-u  scroll · pgdn / pgup  page\nctrl-s layout · enter open · ctrl-e edit · esc back'
    else
      echo none > "$PREEN_STATE/kind"
      FILES="$branch has changed nothing against its merge-base"
      EDIT='{}'; ENTER='ignore'
      HEADER='esc  back to the worktree list'
    fi
    run_picker >/dev/null
    [ -f "$PREEN_STATE/quit" ] && return 0
  done
}

# ---- build the file list -----------------------------------------------------
LABEL=" preen · $KIND${REV:+ · $REV} "
if [ "$KIND" = wt ]; then
  command -v delta >/dev/null || die "delta is not installed"
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not a git repo"
  WTS="$(wt_list)"
  [ -n "$WTS" ] \
    || die "no worktrees besides the main checkout (see: git worktree list)"
  wt_loop
  exit 0
elif [ "$KIND" = md ]; then
  command -v delta >/dev/null || true
  FILES="$(find "${TARGET:-.}" -type f \( -name '*.md' -o -name '*.markdown' \) \
            -not -path '*/.git/*' -not -path '*/node_modules/*' | sed 's|^\./||' | sort)"
  HEADER=$'ctrl-d / ctrl-u  scroll · pgdn / pgup  page\nenter render · ctrl-e edit · ctrl-/ hide · esc quit'
elif [ "$KIND" = pr ]; then
  # read-only: the PR is fetched over the API, never checked out, so the
  # working tree and the current branch are left exactly as they are
  command -v delta >/dev/null || die "delta is not installed"
  command -v gh >/dev/null || die "gh is not installed; see https://cli.github.com"
  gh auth status >/dev/null 2>&1 || die "not logged in to GitHub; run: gh auth login"
  META="$(pr_meta "$PR" 2>&1)" \
    || die "$(printf '%s\n' "$META" | grep -v '^$' | head -n 1)"
  PRNUM="${META%%$'\t'*}"; PRTITLE="${META#*$'\t'}"
  gh pr diff "$PRNUM" > "$PREEN_STATE/pr.diff" 2>"$PREEN_STATE/pr.err" \
    || die "$(grep -v '^$' "$PREEN_STATE/pr.err" | head -n 1)"
  FILES="$(gh pr diff "$PRNUM" --name-only 2>/dev/null)"
  LABEL=" preen · pr #$PRNUM · $(printf '%s' "$PRTITLE" | cut -c1-60) "
  HEADER=$'ctrl-d / ctrl-u  scroll · pgdn / pgup  page\nctrl-s layout · enter open · ctrl-e edit · esc quit'
else
  command -v delta >/dev/null || die "delta is not installed"
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not a git repo"
  # Run from the repo root, not from wherever you happen to be standing.
  # "git diff --name-only" always prints repo-root-relative paths, but
  # "ls-files --others" prints them relative to the cwd, so from a subdirectory
  # the list mixed two path styles -- and render_diff, which also ran git from
  # the cwd, then previewed half of them as empty. Standing at the root makes
  # both halves agree, and matches what "git preen" already does.
  ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" && cd "$ROOT" || true
  if [ -n "$REV" ]; then
    FILES="$(gitw "" diff --name-only "$REV")"
  else
    if git rev-parse --verify -q HEAD >/dev/null 2>&1; then
      FILES="$(gitw "" diff --name-only HEAD; gitw "" ls-files --others --exclude-standard)"
    else
      FILES="$(gitw "" diff --name-only --cached; gitw "" ls-files --others --exclude-standard)"
    fi
    FILES="$(printf '%s\n' "$FILES" | sort -u)"
  fi
  HEADER=$'ctrl-d / ctrl-u  scroll · pgdn / pgup  page\nctrl-s layout · enter open · ctrl-e edit · esc quit'
fi

FILES="$(printf '%s\n' "$FILES" | grep -v '^$')"
[ -n "$FILES" ] || die "nothing to show ($KIND mode)"

ENTER="execute($SELF --show {})"
run_picker >/dev/null
